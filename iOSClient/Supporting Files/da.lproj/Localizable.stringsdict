			<string>Du har %d element, der skal sikkerhedskopieres</string>
			<key>other</key>
			<string>Du har %d elementer, der skal sikkerhedskopieres</string>
		</dict>
	</dict>
	<key>_focused_auto_upload_failed_</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
