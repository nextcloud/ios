<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>_remaining_share_downloads_</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@downloads@</string>
		<key>downloads</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Осталось %d разрешённое скачивание</string>
			<key>few</key>
			<string>Осталось %d разрешённых скачивания</string>
			<key>many</key>
			<string>Осталось %d разрешённых скачиваний</string>
			<key>other</key>
			<string>Осталось %d разрешённого скачивания</string>
		</dict>
	</dict>
	<key>_auto_upload_files_in_queue_</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>В очереди %d файл</string>
			<key>few</key>
			<string>В очереди %d файла</string>
			<key>many</key>
			<string>В очереди %d файлов</string>
			<key>other</key>
			<string>В очереди %d файла</string>
		</dict>
	</dict>
	<key>_focused_auto_upload_photos_to_back_up_</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@photos@</string>
		<key>photos</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>У вас %d элемент для резервного копирования</string>
			<key>few</key>
			<string>У вас %d элемента для резервного копирования</string>
			<key>many</key>
			<string>У вас %d элементов для резервного копирования</string>
			<key>other</key>
			<string>У вас %d элемента для резервного копирования</string>
		</dict>
	</dict>
	<key>_focused_auto_upload_failed_</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@failed@</string>
		<key>failed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Не удалось: %d</string>
			<key>few</key>
			<string>Не удалось: %d</string>
			<key>many</key>
			<string>Не удалось: %d</string>
			<key>other</key>
			<string>Не удалось: %d</string>
		</dict>
	</dict>
	<key>_albums_photos_count_</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@photos@</string>
		<key>photos</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d фотография</string>
			<key>few</key>
			<string>%d фотографии</string>
			<key>many</key>
			<string>%d фотографий</string>
			<key>other</key>
			<string>%d фотографии</string>
		</dict>
	</dict>
	<key>_albums_list_photos_and_videos_count_</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@media@</string>
		<key>media</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d фото или видео</string>
			<key>few</key>
			<string>%d фото и видео</string>
			<key>many</key>
			<string>%d фото и видео</string>
			<key>other</key>
